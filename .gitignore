# ==============================================================================
# STOCKLY - .gitignore Canónico
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Variables de Entorno y Credenciales
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.local

# Claves criptográficas, certificados y credenciales locales
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.pkcs12
id_rsa*
id_ed25519*

# ------------------------------------------------------------------------------
# 2. Supabase Local y Runtimes
# ------------------------------------------------------------------------------
supabase/.temp/
supabase/.branches/
supabase/.env.keys
supabase/.env.local
supabase/.env.*.local
.temp/

# ------------------------------------------------------------------------------
# 3. Dependencias, Compilación y Cachés de Frontend / Node.js
# ------------------------------------------------------------------------------
node_modules/
dist/
build/
out/
.next/
.cache/
coverage/

# Logs de gestores de paquetes y procesos
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ------------------------------------------------------------------------------
# 4. Archivos de Sistema Operativo y Editores / IDEs
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# Visual Studio Code (configuración de usuario y espacio de trabajo local)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace

# JetBrains / IntelliJ / WebStorm
.idea/
*.iws
*.iml

# Visual Studio
*.suo
*.user
*.userosscache
*.sln.docstates

# Archivos de respaldo temporales
*~
*.swp
*.swo
