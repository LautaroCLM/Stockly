{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Stockly",
  "version": "0.1.0",
  "identifier": "com.laperla.stockly",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Stockly",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Gestión comercial e inventario",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ]
      }
    }
  }
}