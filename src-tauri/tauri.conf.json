{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Stockly",
  "version": "0.2.0",
  "identifier": "com.laperla.stockly",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Stockly",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Gestión comercial e inventario",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBMTBFNkZCRDNGMzE3OUIKUldTYkYvUFQrK1lRcW5CMDVYSWNXWDJsdDUrVzhoVTkvRXdmaHpFNzhJOS82cXZsWkQ3YmZjTmkK",
      "endpoints": [
        "https://github.com/LautaroCLM/Stockly/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
